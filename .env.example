# LMS management web — Vite env (import.meta.env). Copy to .env and fill in.
# Only VITE_* vars are exposed to the client. Do not put secrets here.

# Core API base URL (required). No trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Public S3 bucket base URL (required). No trailing slash.
# Example: https://your-public-bucket.s3.ap-southeast-1.amazonaws.com
VITE_PUBLIC_STORAGE_BASE_URL=

# Cognito OIDC (required). Public SPA client — no client secret.
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Hosted UI host only, no https://
# Example: myapp-dev-abc.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Optional. Must match the Cognito app client callback / logout URLs.
# Defaults shown are used when unset.
VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback
VITE_AUTH_LOGOUT_URI=http://localhost:3000/
