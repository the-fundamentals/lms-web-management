# Cognito OIDC (management web — public SPA client, no secret)
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Hosted UI host only, e.g. myapp-dev-abc123.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback
VITE_AUTH_LOGOUT_URI=http://localhost:3000/

# LMS Core API base URL (no trailing slash), e.g. http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
